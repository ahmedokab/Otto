# Copy to .env and fill in. Without a key the app runs fully offline (knowledge-base explanations).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_S=120
# 0 = decode the VIN offline only (never send it to NHTSA's free decoder)
OTTO_VIN_LOOKUP=1
# Serial number of the FREE-WILi to use when several are plugged in
FREEWILI_PORT=
